<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DSA Atlas — every topic, ranked by difficulty</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f3ee;--fg:#1c1b22;--mute:#6b6877;--card:rgba(255,255,255,.7);--line:rgba(28,27,34,.1);--a:#6d5efc;--b:#ff7a9c;
--l1:#2fbf8f;--l2:#6cc04a;--l3:#f0a729;--l4:#ee6a4a;--l5:#c2335f;
--serif:'Fraunces',Georgia,serif;--sans:'Inter',system-ui,-apple-system,sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e0d14;--fg:#efedf6;--mute:#9a96ab;--card:rgba(255,255,255,.05);--line:rgba(255,255,255,.1);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0e0d14;--fg:#efedf6;--mute:#9a96ab;--card:rgba(255,255,255,.05);--line:rgba(255,255,255,.1);color-scheme:dark}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.6 var(--sans);overflow-x:hidden}
.glow{position:fixed;inset:0;z-index:-1;pointer-events:none}
.glow i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.35;animation:fl 18s ease-in-out infinite alternate}
.glow i:nth-child(1){width:46vw;height:46vw;background:var(--a);top:-12vw;left:-8vw}
.glow i:nth-child(2){width:38vw;height:38vw;background:var(--b);top:30vh;right:-10vw;animation-delay:-6s}
.glow i:nth-child(3){width:34vw;height:34vw;background:#38c7e8;bottom:-10vw;left:25vw;animation-delay:-11s;opacity:.22}
@keyframes fl{to{transform:translate(4vw,6vh) scale(1.15)}}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
nav{display:flex;justify-content:space-between;align-items:center;padding:22px 0}
.logo{font:700 22px var(--serif);letter-spacing:-.02em}.logo b{color:var(--a)}
.tg{border:1px solid var(--line);background:var(--card);color:var(--fg);width:40px;height:40px;border-radius:50%;cursor:pointer;font-size:17px;backdrop-filter:blur(10px)}
header{padding:70px 0 40px;text-align:center}
.eyebrow{display:inline-block;padding:6px 14px;border:1px solid var(--line);border-radius:99px;background:var(--card);font-size:13px;color:var(--mute);backdrop-filter:blur(10px)}
h1{font:700 clamp(40px,7vw,82px)/1.02 var(--serif);letter-spacing:-.035em;margin:22px auto 18px;max-width:900px}
h1 em{font-style:italic;background:linear-gradient(100deg,var(--a),var(--b));-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{max-width:600px;margin:0 auto 34px;color:var(--mute);font-size:18px}
.stats{display:flex;justify-content:center;gap:clamp(18px,5vw,56px);flex-wrap:wrap}
.stats div{text-align:center}.stats b{display:block;font:700 34px var(--serif)}.stats span{font-size:13px;color:var(--mute)}
.legend{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:46px 0 8px;font-size:13px;color:var(--mute)}
.legend span{display:flex;align-items:center;gap:7px}.legend i{width:10px;height:10px;border-radius:50%}
.bar{position:sticky;top:0;z-index:5;margin:22px 0 30px;padding:14px;border:1px solid var(--line);border-radius:20px;background:var(--card);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.bar input{flex:1 1 220px;border:1px solid var(--line);background:transparent;color:var(--fg);padding:11px 16px;border-radius:12px;font:inherit;outline:none}
.bar input:focus{border-color:var(--a)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:transparent;color:var(--fg);padding:8px 14px;border-radius:99px;font:500 13px var(--sans);cursor:pointer;transition:.2s}
.chip:hover{border-color:var(--a)}.chip.on{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.sort{border:1px solid var(--line);background:transparent;color:var(--fg);padding:9px 12px;border-radius:12px;font:inherit;font-size:13px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:18px}
.card{--c:var(--l1);position:relative;padding:24px;border:1px solid var(--line);border-radius:22px;background:var(--card);backdrop-filter:blur(12px);overflow:hidden;opacity:0;transform:translateY(22px);transition:opacity .6s,transform .6s,box-shadow .3s,border-color .3s}
.card.in{opacity:1;transform:none}
.card:hover{transform:translateY(-5px);border-color:var(--c);box-shadow:0 18px 40px -18px var(--c)}
.card::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;background:var(--c)}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.cat{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}
.lv{font-size:12px;font-weight:600;padding:4px 11px;border-radius:99px;color:var(--c);background:color-mix(in srgb,var(--c) 14%,transparent)}
.card h3{font:600 23px/1.2 var(--serif);margin:0 0 8px;letter-spacing:-.01em}
.card p{margin:0 0 16px;color:var(--mute);font-size:14.5px}
.meter{display:flex;gap:4px;margin-bottom:14px}.meter i{flex:1;height:5px;border-radius:9px;background:var(--line)}.meter i.f{background:var(--c)}
.meta{display:flex;justify-content:space-between;font-size:13px;color:var(--mute);border-top:1px dashed var(--line);padding-top:12px}
.meta b{color:var(--fg);font-weight:600}
.tags{margin-top:12px;font-size:12.5px;color:var(--mute)}.tags span{color:var(--c);font-weight:500}
.empty{text-align:center;color:var(--mute);padding:60px 0;display:none}
section.blk{margin-top:100px}
h2{font:700 clamp(30px,4.5vw,46px)/1.1 var(--serif);letter-spacing:-.025em;margin:0 0 10px}
.lead{color:var(--mute);max-width:560px;margin:0 0 34px}
.road{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;counter-reset:s}
.step{counter-increment:s;padding:22px;border:1px solid var(--line);border-radius:20px;background:var(--card)}
.step::before{content:"0" counter(s);font:italic 700 34px var(--serif);color:var(--a)}
.step h4{margin:6px 0;font:600 18px var(--serif)}.step p{margin:0;font-size:14px;color:var(--mute)}
.pat{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
.pat div{padding:18px 20px;border:1px solid var(--line);border-radius:16px;background:var(--card);font-size:14px;color:var(--mute)}
.pat b{display:block;color:var(--fg);font:600 17px var(--serif);margin-bottom:3px}
.tbl{overflow-x:auto;border:1px solid var(--line);border-radius:20px;background:var(--card)}
table{width:100%;border-collapse:collapse;font-size:14px;min-width:560px}
th,td{padding:13px 18px;text-align:left;border-bottom:1px solid var(--line)}th{font-weight:600;color:var(--mute);font-size:12px;text-transform:uppercase;letter-spacing:.08em}
tr:last-child td{border:0}td:first-child{font-weight:600}code{font-family:ui-monospace,Menlo,monospace;color:var(--a);font-size:13px}
footer{margin:110px 0 40px;text-align:center;color:var(--mute);font-size:14px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.card{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="glow"><i></i><i></i><i></i></div>
<div class="wrap">
<nav><div class="logo">DSA<b>.</b>Atlas</div><button class="tg" id="tg" aria-label="Toggle theme">◐</button></nav>
<header>
<span class="eyebrow">✦ A complete map of Data Structures &amp; Algorithms</span>
<h1>Every topic, <em>ranked</em> by how hard it really is.</h1>
<p class="sub">Browse, filter and plan your journey. Each topic has a short introduction, a difficulty level and an honest estimate of the time it takes to learn.</p>
<div class="stats"><div><b id="n">0</b><span>topics</span></div><div><b>5</b><span>difficulty levels</span></div><div><b id="h">0</b><span>hours, start to finish</span></div></div>
<div class="legend" id="lg"></div>
</header>

<div class="bar">
<input id="q" type="search" placeholder="Search a topic, e.g. “heap”, “DP”, “graph”…">
<select class="sort" id="so"><option value="lvl">Sort: easiest first</option><option value="lvd">Sort: hardest first</option><option value="hrs">Sort: quickest to learn</option><option value="hrd">Sort: longest to learn</option></select>
<div class="chips" id="lc"></div>
<div class="chips" id="cc"></div>
</div>
<div class="grid" id="g"></div>
<div class="empty" id="e">No topics match. Try clearing a filter.</div>

<section class="blk">
<h2>A sensible order to learn</h2>
<p class="lead">You don’t have to go in a straight line, but this path avoids the usual dead ends.</p>
<div class="road">
<div class="step"><h4>Foundations</h4><p>Complexity, arrays, strings, recursion and hashing. Solve 40–60 easy problems.</p></div>
<div class="step"><h4>Core structures</h4><p>Linked lists, stacks, queues, trees, heaps. Learn when each one wins.</p></div>
<div class="step"><h4>Techniques</h4><p>Binary search, two pointers, backtracking, greedy and basic DP.</p></div>
<div class="step"><h4>Graphs</h4><p>BFS, DFS, shortest paths, union-find, topological order.</p></div>
<div class="step"><h4>Advanced</h4><p>Hard DP, segment trees, flows and string algorithms, only if you need them.</p></div>
</div>
</section>

<section class="blk">
<h2>Patterns that unlock problems</h2>
<p class="lead">Most interview questions are one of these in disguise.</p>
<div class="pat">
<div><b>Sliding window</b>Longest or shortest subarray satisfying a condition.</div>
<div><b>Two pointers</b>Sorted arrays, pair sums, palindromes, partitioning.</div>
<div><b>Fast &amp; slow pointers</b>Cycle detection and finding middles in linked lists.</div>
<div><b>Merge intervals</b>Scheduling, overlaps, meeting rooms.</div>
<div><b>Top-K with heap</b>K largest, K closest, streaming medians.</div>
<div><b>BFS on grids</b>Shortest path in mazes, flood fill, multi-source spreading.</div>
<div><b>Backtracking</b>Subsets, permutations, N-Queens, Sudoku.</div>
<div><b>State-space DP</b>Define state, transition, base case, then optimize.</div>
</div>
</section>

<section class="blk">
<h2>Complexity cheat sheet</h2>
<p class="lead">The numbers worth knowing by heart.</p>
<div class="tbl"><table>
<tr><th>Structure</th><th>Access</th><th>Search</th><th>Insert</th><th>Delete</th></tr>
<tr><td>Array</td><td><code>O(1)</code></td><td><code>O(n)</code></td><td><code>O(n)</code></td><td><code>O(n)</code></td></tr>
<tr><td>Linked list</td><td><code>O(n)</code></td><td><code>O(n)</code></td><td><code>O(1)</code></td><td><code>O(1)</code></td></tr>
<tr><td>Hash table</td><td>n/a</td><td><code>O(1)</code> avg</td><td><code>O(1)</code> avg</td><td><code>O(1)</code> avg</td></tr>
<tr><td>Balanced BST</td><td><code>O(log n)</code></td><td><code>O(log n)</code></td><td><code>O(log n)</code></td><td><code>O(log n)</code></td></tr>
<tr><td>Binary heap</td><td>min <code>O(1)</code></td><td><code>O(n)</code></td><td><code>O(log n)</code></td><td><code>O(log n)</code></td></tr>
<tr><td>Trie</td><td>n/a</td><td><code>O(L)</code></td><td><code>O(L)</code></td><td><code>O(L)</code></td></tr>
</table></div>
</section>
<footer>Built to help you learn DSA calmly and in the right order. ✦</footer>
</div>

<script>
const LV=[["Beginner","var(--l1)"],["Easy","var(--l2)"],["Moderate","var(--l3)"],["Hard","var(--l4)"],["Expert","var(--l5)"]];
// name, category, level(1-5), hours, intro, key problems
const D=[
["Time &amp; Space Complexity","Foundations",1,6,"The language for comparing solutions. Learn Big-O so you can tell fast from slow before writing code.","Loop analysis, amortized cost"],
["Arrays","Foundations",1,10,"Contiguous memory with instant access by index. The base of almost every other structure.","Rotate array, max subarray"],
["Strings","Foundations",1,10,"Arrays of characters with their own tricks: parsing, comparison, anagrams and palindromes.","Anagrams, longest palindrome"],
["Recursion","Foundations",2,12,"A function calling itself on a smaller problem. Hard to see at first, but the key to trees, DP and backtracking.","Fibonacci, power, hanoi"],
["Bit Manipulation","Foundations",2,8,"Work directly on binary representations for compact, very fast solutions.","Single number, subsets by mask"],
["Math &amp; Number Theory","Foundations",3,20,"Primes, GCD, modular arithmetic and combinatorics that appear in contest and interview problems.","Sieve, fast exponentiation, nCr"],
["Hash Tables","Linear",1,10,"Key-value lookup in near constant time. The most useful trade of memory for speed.","Two sum, group anagrams"],
["Linked Lists","Linear",2,12,"Nodes connected by pointers. Teaches pointer thinking and in-place manipulation.","Reverse list, detect cycle"],
["Stacks","Linear",2,8,"Last in, first out. Powers undo, parsing and expression evaluation.","Valid parentheses, min stack"],
["Queues &amp; Deques","Linear",2,8,"First in, first out, with a double-ended variant for sliding structures.","Circular queue, sliding max"],
["Prefix Sums","Linear",2,6,"Precompute running totals to answer range queries in constant time.","Subarray sum equals K"],
["Two Pointers &amp; Sliding Window","Techniques",2,14,"Move two indices cleverly to turn quadratic scans into linear ones.","3Sum, longest unique substring"],
["Monotonic Stack","Linear",3,10,"A stack kept in sorted order to find the next greater or smaller element quickly.","Next greater, largest rectangle"],
["Binary Search","Searching &amp; Sorting",2,12,"Halve the search space each step. Works on answers, not just sorted arrays.","Search rotated array, Koko bananas"],
["Sorting Algorithms","Searching &amp; Sorting",2,14,"Bubble to merge, quick and counting sort. Understand the trade-offs, not just the code.","Merge sort, quickselect"],
["Heaps &amp; Priority Queues","Searching &amp; Sorting",3,12,"Always get the smallest or largest item fast. Essential for top-K and scheduling.","K largest, merge K lists"],
["Intervals &amp; Sweep Line","Techniques",3,10,"Sort by start or end and sweep through to resolve overlaps and schedules.","Merge intervals, meeting rooms"],
["Greedy Algorithms","Paradigms",3,16,"Take the best local choice and prove it leads to the best global answer.","Jump game, activity selection"],
["Divide &amp; Conquer","Paradigms",3,12,"Split, solve the halves, combine. The idea behind merge sort and many fast algorithms.","Count inversions, closest pair"],
["Backtracking","Paradigms",3,18,"Build solutions step by step and undo choices that fail. Explores all possibilities smartly.","N-Queens, permutations, sudoku"],
["Binary Trees","Trees",2,16,"Hierarchical data with traversals in pre, in, post and level order.","Max depth, lowest common ancestor"],
["Binary Search Trees","Trees",3,12,"Ordered trees with fast search, insert and delete when balanced.","Validate BST, kth smallest"],
["Tries","Trees",3,10,"Prefix trees for autocomplete, dictionaries and word search.","Implement trie, word search II"],
["Graph Basics (BFS &amp; DFS)","Graphs",3,24,"Model networks as nodes and edges and explore them level by level or depth first.","Number of islands, clone graph"],
["Topological Sort","Graphs",3,8,"Order tasks so dependencies always come first, using DAGs.","Course schedule, build order"],
["Union-Find (DSU)","Graphs",3,10,"Track connected groups with near constant merge and find operations.","Redundant connection, accounts merge"],
["Shortest Paths","Graphs",4,20,"Dijkstra, Bellman-Ford and Floyd-Warshall for weighted graphs.","Network delay, cheapest flights"],
["Minimum Spanning Tree","Graphs",4,10,"Connect every node at lowest total cost using Kruskal or Prim.","Min cost to connect points"],
["Dynamic Programming: Basics","Paradigms",3,30,"Break problems into overlapping subproblems and store answers. 1D and simple 2D states.","Climbing stairs, knapsack, LCS"],
["Dynamic Programming: Advanced","Paradigms",5,50,"Bitmask, digit, interval and tree DP with state compression and optimizations.","TSP, burst balloons, digit count"],
["Segment Trees","Advanced",4,16,"Range queries and updates in log time, with lazy propagation for range edits.","Range sum, range min with updates"],
["Fenwick Tree (BIT)","Advanced",4,8,"A compact structure for prefix queries with point updates.","Count smaller after self"],
["Balanced Trees (AVL, Red-Black)","Advanced",4,16,"Self-balancing trees using rotations to guarantee log-time operations.","AVL rotations, order statistics"],
["String Algorithms (KMP, Z, Hashing)","Advanced",4,18,"Fast pattern matching and rolling hashes for large texts.","Find needle, repeated substring"],
["SCC, Bridges &amp; Articulation Points","Advanced",5,16,"Tarjan and Kosaraju reveal the fragile structure of a graph.","Critical connections, SCC count"],
["Network Flow &amp; Matching","Advanced",5,30,"Max-flow and bipartite matching for assignment and capacity problems.","Dinic, Hopcroft-Karp"],
["Suffix Arrays &amp; Automata","Advanced",5,30,"Powerful tools for substring queries and string counting in contests.","Distinct substrings, LCP"],
["Computational Geometry","Advanced",5,24,"Convex hull, line intersection and sweep-line geometry.","Convex hull, polygon area"]
];
const CATS=["All",...new Set(D.map(d=>d[1].replace("&amp;","&")))];
const $=s=>document.querySelector(s);let lv=0,cat="All";
$("#n").textContent=D.length;$("#h").textContent=D.reduce((a,d)=>a+d[3],0);
$("#lg").innerHTML=LV.map(l=>`<span><i style="background:${l[1]}"></i>${l[0]}</span>`).join("");
const mk=(el,items,on)=>{el.innerHTML=items.map((t,i)=>`<button class="chip${i?"":" on"}" data-i="${i}">${t}</button>`).join("");el.onclick=e=>{const b=e.target.closest("button");if(!b)return;[...el.children].forEach(c=>c.classList.remove("on"));b.classList.add("on");on(+b.dataset.i);render()}};
mk($("#lc"),["Any level",...LV.map(l=>l[0])],i=>lv=i);
mk($("#cc"),CATS,i=>cat=CATS[i]);
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}}),{threshold:.08});
function T(h){return h<24?"~"+h+" hrs":"~"+(Math.round(h/10)/ (1) ) +"0 hrs"}
function render(){
 const q=$("#q").value.toLowerCase(),s=$("#so").value;
 let r=D.filter(d=>(!lv||d[2]==lv)&&(cat=="All"||d[1].replace("&amp;","&")==cat)&&(d[0]+d[4]+d[5]).toLowerCase().includes(q));
 r.sort((a,b)=>s=="lvl"?a[2]-b[2]||a[3]-b[3]:s=="lvd"?b[2]-a[2]||b[3]-a[3]:s=="hrs"?a[3]-b[3]:b[3]-a[3]);
 $("#g").innerHTML=r.map(d=>{const l=LV[d[2]-1];return `<article class="card" style="--c:${l[1]}"><div class="top"><span class="cat">${d[1]}</span><span class="lv">${l[0]}</span></div><h3>${d[0]}</h3><p>${d[4]}</p><div class="meter">${[1,2,3,4,5].map(i=>`<i class="${i<=d[2]?"f":""}"></i>`).join("")}</div><div class="meta"><span>Difficulty <b>${d[2]}/5</b></span><span>Time to learn <b>~${d[3]} hrs</b></span></div><div class="tags">Practice: <span>${d[5]}</span></div></article>`}).join("");
 $("#e").style.display=r.length?"none":"block";
 document.querySelectorAll(".card").forEach((c,i)=>{c.style.transitionDelay=Math.min(i%6,5)*60+"ms";io.observe(c)});
}
$("#q").oninput=render;$("#so").onchange=render;
$("#tg").onclick=()=>{const r=document.documentElement,d=r.dataset.theme?r.dataset.theme=="dark":matchMedia("(prefers-color-scheme:dark)").matches;r.dataset.theme=d?"light":"dark"};
render();
</script>
</body>
</html>
